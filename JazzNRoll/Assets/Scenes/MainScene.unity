--- !u!114 &726760091
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 726760084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e6264d46ec962c46851c4d3a949c1d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameEndManager
  _loseSprite: {fileID: 21300000, guid: 62671d848c3a8b2449159a8431cb67df, type: 3}
  _loseTexts:
  - "\u041A\u043E\u0441\u0442\u0438 \u0432\u044B\u043F\u0430\u043B\u0438 \u043D\u0435
    \u0432 \u0442\u0432\u043E\u044E \u043F\u043E\u043B\u044C\u0437\u0443. \u041C\u0430\u0444\u0438\u044F
    \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E\u0432.
    \u0422\u0432\u043E\u044F \u043D\u043E\u0432\u0430\u044F \u0441\u0442\u0430\u0432\u043A\u0430
    \u2014 \u0436\u0438\u0437\u043D\u044C, \u0430 \u0442\u0432\u043E\u0439 \u043D\u043E\u0432\u044B\u0439
    \u0434\u043E\u043C \u2014 \u044D\u0442\u043E\u0442 \u0442\u0435\u043C\u043D\u044B\u0439
    \u043F\u043E\u0434\u0432\u0430\u043B."
  - The dice have failed you, and the mafia shows no mercy. Your final wager has
    cost you your life. Welcome to your dungeon.
  _loseButtonTexts:
  - "\u0421\u0434\u0430\u0442\u044C\u0441\u044F"
  - Give up
  _winSprite: {fileID: 21300000, guid: 43fae70b8b299d44c93ef0696a62cd65, type: 3}
  _winTexts:
  - "\u0422\u044B \u0440\u0438\u0441\u043A\u043D\u0443\u043B \u0432\u0441\u0435\u043C,
    \u043E\u0431\u044B\u0433\u0440\u0430\u043B \u043A\u043E\u0441\u0442\u0438 \u0438
    \u0432\u0435\u0440\u043D\u0443\u043B \u0434\u043E\u043B\u0433 \u043C\u0430\u0444\u0438\u0438.
    \u0423\u0445\u043E\u0434\u0438 \u0438 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439\u0441\u044F.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0434\u0430\u0447\u0430 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430
    \u0442\u0435\u0431\u0435 \u0436\u0438\u0437\u043D\u044C."
  - "You risked it all, beat the dice, and cleared your mafia debt. Walk away and
    don\u2019t look back. Luck saved your life."
  _winButtonTexts:
  - "\u0423\u0439\u0442\u0438"
  - Leave
  _gameEnd: {fileID: 891688490}
