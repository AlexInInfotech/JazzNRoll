      value: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
        \u0432 \u043F\u043E\u0434\u043F\u043E\u043B\u044C\u043D\u044B\u0439 \u043A\u043B\u0443\u0431!\n\u041F\u0435\u0440\u0435\u0434
