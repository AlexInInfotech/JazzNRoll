    - target: {fileID: 8464414538785131519, guid: 1c57ed4e6a9dd644d88f842af4281cbb, type: 3}
      propertyPath: m_text
      value: "\u0421\u0442\u0430\u0432\u043A\u0430 \u0432 70 \u043E\u0447\u043A\u043E\u0432
        \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0431\u0440\u043E\u0441\u043A\u043E\u0432,
        \u043D\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u043B\u0438\u0442
        \u043C\u0430\u0444\u0438\u044E.\n\u0421\u0442\u0430\u0432\u043A\u0430 \u0432
        30 \u043E\u0447\u043A\u043E\u0432 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
        \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435
        \u0431\u0440\u043E\u0441\u043A\u043E\u0432, \u043D\u043E \u0436\u0430\u043B\u043E\u0441\u0442\u044C
        \u043C\u0430\u0444\u0438\u0438 \u043A \u0432\u0430\u043C \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442."
      objectReference: {fileID: 0}
